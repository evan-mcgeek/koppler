{
  "name": "koppler",
  "version": "0.0.0",
  "private": true,
  "description": "Run the part of your stack you need locally, wired together, while the rest keeps calling a deployed environment.",
  "license": "MIT",
  "author": "Ivan Yanowsky",
  "homepage": "https://github.com/evan-mcgeek/koppler",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evan-mcgeek/koppler.git",
    "directory": "app"
  },
  "bugs": "https://github.com/evan-mcgeek/koppler/issues",
  "keywords": [
    "local-development",
    "microservices",
    "dev-environment",
    "canvas",
    "dotnet",
    "flutter",
    "aws"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "koppler": "dist/koppler.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "test": "npm run build && vitest run && node --test --test-concurrency=1 test/*.test.mjs",
    "test:canvas": "npm run build && playwright test",
    "start": "node src/koppler.mjs canvas",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
