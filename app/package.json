{
  "name": "koppler",
  "version": "0.0.0",
  "private": true,
  "description": "Run the part of your stack you need locally, wired together, while the rest keeps calling a deployed environment.",
  "license": "MIT",
  "author": "Ivan Yanowsky",
  "homepage": "https://github.com/evan-mcgeek/koppler",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evan-mcgeek/koppler.git",
    "directory": "app"
  },
  "bugs": "https://github.com/evan-mcgeek/koppler/issues",
  "keywords": [
    "local-development",
    "microservices",
    "dev-environment",
    "canvas",
    "dotnet",
    "flutter",
    "aws"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "koppler": "dist/koppler.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "test": "npm run build && vitest run && node --test --test-concurrency=1 test/*.test.mjs",
    "test:canvas": "npm run build && playwright test",
    "start": "node scripts/koppler-dev.mjs canvas",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types": "tsc --noEmit && svelte-check --workspace canvas --tsconfig ./tsconfig.json --fail-on-warnings",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "@xyflow/svelte": "^1.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "dependencies": {
    "zod": "^4.6.5"
  }
}
