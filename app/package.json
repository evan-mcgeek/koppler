{
  "name": "koppler",
  "version": "0.0.0",
  "private": true,
  "description": "Run the part of your stack you need locally, wired together, while the rest keeps calling a deployed environment.",
  "license": "MIT",
  "author": "Ivan Yanowsky",
  "homepage": "https://github.com/evan-mcgeek/koppler",
  "repository": { "type": "git", "url": "git+https://github.com/evan-mcgeek/koppler.git", "directory": "app" },
  "bugs": "https://github.com/evan-mcgeek/koppler/issues",
  "keywords": ["local-development", "microservices", "dev-environment", "canvas", "dotnet", "flutter", "aws"],
  "engines": { "node": ">=22" },
  "os": ["darwin", "linux"],
  "bin": { "koppler": "src/koppler.mjs" },
  "files": ["src", "bin", "!src/**/*.test.mjs"],
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:canvas": "playwright test",
    "start": "node src/koppler.mjs canvas"
  },
  "devDependencies": { "@playwright/test": "^1.64.0" }
}
