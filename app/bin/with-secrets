#!/usr/bin/env bash
# Runs a command with an app's stored secrets in its environment only. For a log on the canvas, start the app with `koppler run <app>` instead.
# Usage: with-secrets <app> -- <command...>     (<app>@<env> for an environment other than the stack's first)
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)
app=${1:?usage: with-secrets <app> -- <command...>}; shift
[[ $app =~ ^[a-z0-9-]+(@[a-z0-9-]+)?$ ]] || { echo "invalid app id: $app" >&2; exit 1; }
[[ ${1:-} == -- ]] && shift
(( $# )) || { echo "usage: with-secrets <app> -- <command...>" >&2; exit 1; }
names=$("$here/secret-store" names "$app" | sed 's/^[^:]*: *//')
[[ -n $names ]] || echo "no secrets stored for $app, running without" >&2
for name in $names; do
  value=$("$here/secret-store" value "$app" "$name") || { echo "could not read $name for $app (was the Keychain prompt denied?)" >&2; exit 1; }
  export "$name=$value"
done
unset value
exec "$@"
