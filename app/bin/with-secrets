#!/usr/bin/env bash
# Runs a command with an app's stored secrets in its environment only. For a log on the canvas, start the app with `koppler run <app>` instead.
# Usage: with-secrets <app> -- <command...>     (<app>@<env> for an environment other than the stack's first)
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)
app=${1:?usage: with-secrets <app> -- <command...>}; shift
[[ $app =~ ^[a-z0-9-]+(@[a-z0-9-]+)?$ ]] || { echo "invalid app id: $app" >&2; exit 1; }
[[ ${1:-} == -- ]] && shift
(( $# )) || { echo "usage: with-secrets <app> -- <command...>" >&2; exit 1; }
names=$("$here/secret-store" names "$app" | sed 's/^[^:]*: *//')
[[ -n $names ]] || echo "no secrets stored for $app, running without" >&2
for name in $names; do
  [[ $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo "skipping a stored name that is not a variable name" >&2; continue; }
  # A stored value never becomes a variable that makes a runtime load other code or find its programs elsewhere.
  case $name in
    PATH|NODE_OPTIONS|NODE_PATH|DYLD_*|LD_*|DOTNET_STARTUP_HOOKS|DOTNET_ADDITIONAL_DEPS|DOTNET_SHARED_STORE|CORECLR_*|COR_*|BASH_ENV|ENV|PROMPT_COMMAND|PYTHONSTARTUP|PYTHONPATH|PYTHONHOME|PYTHONINSPECT|RUBYOPT|RUBYLIB|PERL5OPT|PERL5LIB|JAVA_TOOL_OPTIONS|_JAVA_OPTIONS|JDK_JAVA_OPTIONS)
      echo "refusing to start: the stored secret $name for $app would make the app run other code; remove it (koppler secret remove $app $name)" >&2; exit 1 ;;
  esac
  value=$("$here/secret-store" value "$app" "$name") || { echo "could not read $name for $app (was the Keychain prompt denied?)" >&2; exit 1; }
  export "$name=$value"
done
unset value
exec "$@"
