#!/usr/bin/env bash
# Lists stored secret names for an app (or all apps). Never prints values.
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)
[[ -z ${1:-} || $1 =~ ^[a-z0-9-]+(@[a-z0-9-]+)?$ ]] || { echo "invalid app id: $1" >&2; exit 1; }
out=$("$here/secret-store" names ${1:+"$1"})
[[ -n $out ]] && echo "$out" || echo "no secrets stored${1:+ for $1}"
