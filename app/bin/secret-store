#!/usr/bin/env bash
# Where Koppler keeps secret values: the macOS Keychain, or private files where there is none (or when KOPPLER_SECRETS names a folder).
# The other secret-* scripts and with-secrets go through this one. A store is <app> or <app>@<env>.
# Usage: secret-store set <store> <NAME>      value on stdin
#        secret-store names [<store>]         "<store>: NAME NAME" per store; never values
#        secret-store value <store> <NAME>    the value, for with-secrets and the checks only
#        secret-store remove <store> <NAME>
#        secret-store migrate                 move values from the private files into the Keychain
#        secret-store protected <store>       exit 0 when the store is protected
# In the Keychain, a protected store asks you on every read; the others are readable without asking, by anything running as you.
set -uo pipefail
cmd=${1:?usage: secret-store set|names|value|remove|migrate|protected ...}; shift
store=${1:-}; name=${2:-}
dir=${KOPPLER_SECRETS:-$HOME/.config/koppler/secrets}
backend=${KOPPLER_SECRET_BACKEND:-$([[ -z ${KOPPLER_SECRETS:-} && $(uname) == Darwin ]] && echo keychain || echo files)}
prefix=${KOPPLER_KEYCHAIN_PREFIX:-koppler}
# A keychain file of its own instead of the user's default one (KOPPLER_KEYCHAIN), e.g. for the tests.
in_keychain=(); [[ -n ${KOPPLER_KEYCHAIN:-} ]] && in_keychain=("$KOPPLER_KEYCHAIN")

check_store() { [[ $store =~ ^[a-z0-9-]+(@[a-z0-9-]+)?$ ]] || { echo "invalid app id: $store" >&2; exit 2; }; }
check_name() { [[ $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo "invalid env name: $name" >&2; exit 2; }; }
# Koppler says which stores are protected (KOPPLER_SECRET_PROTECTED=1 or 0, from the stack's protected environments).
# Called without it, every store of a named environment (<app>@<env>) is protected: never decided by the environment's name.
protected() { case ${KOPPLER_SECRET_PROTECTED:-} in 1) return 0 ;; 0) return 1 ;; esac; [[ $1 == *@* ]]; }

files_set() {
  local file=$dir/$store.env tmp value; value=$(cat)
  umask 077; mkdir -p "$dir"; chmod 700 "$dir"; touch "$file"; chmod 600 "$file"
  tmp=$(mktemp "$dir/.tmp.XXXXXX")
  grep -v "^export $name=" "$file" > "$tmp" || true
  printf 'export %s=%q\n' "$name" "$value" >> "$tmp"
  mv "$tmp" "$file"
}
files_names() {
  shopt -s nullglob
  local f files=("$dir"/${store:-*}.env)
  for f in "${files[@]}"; do [[ -f $f ]] && echo "$(basename "$f" .env): $(sed -nE 's/^export ([A-Za-z_][A-Za-z0-9_]*)=.*/\1/p' "$f" | paste -sd ' ' -)"; done
  return 0
}
files_value() { local file=$dir/$store.env; [[ -f $file ]] || return 1; (set -a; source "$file"; [[ -n ${!name+x} ]] && printf '%s' "${!name}"); }
files_remove() { local file=$dir/$store.env tmp; [[ -f $file ]] || return 0; tmp=$(mktemp "$dir/.tmp.XXXXXX"); grep -v "^export $name=" "$file" > "$tmp" || true; mv "$tmp" "$file"; [[ -s $file ]] || rm -f "$file"; }

keychain_set() {
  # Kept as hex text, so any value (quotes, accents, several lines) comes back exactly as it went in.
  local hex trust; hex=$(xxd -p | tr -d '\n')
  [[ -n $hex ]] || { echo "empty value, nothing saved" >&2; exit 1; }
  protected "$store" && trust='-T ""' || trust='-T /usr/bin/security'
  security delete-generic-password -s "$prefix:$store" -a "$name" ${in_keychain[@]+"${in_keychain[@]}"} >/dev/null 2>&1
  # Through security's own prompt, so the value is never on a command line other processes can see.
  printf 'add-generic-password -s "%s" -a "%s" -l "%s" %s -X %s%s\n' "$prefix:$store" "$name" "Koppler: $name for $store" "$trust" "$(printf '%s' "$hex" | xxd -p | tr -d '\n')" "${KOPPLER_KEYCHAIN:+ \"$KOPPLER_KEYCHAIN\"}" | security -i >/dev/null
}
keychain_names() {
  security dump-keychain ${in_keychain[@]+"${in_keychain[@]}"} 2>/dev/null | awk -v p="\"svce\"<blob>=\"$prefix:" -v want="$store" '
    /^keychain:/ { acct = ""; svce = "" }
    index($0, "\"acct\"<blob>=\"") { v = $0; sub(/.*"acct"<blob>="/, "", v); sub(/"$/, "", v); acct = v }
    index($0, p) { v = $0; sub(/.*"svce"<blob>="[^:]*:/, "", v); sub(/"$/, "", v); svce = v }
    acct != "" && svce != "" { if (want == "" || want == svce) names[svce] = names[svce] " " acct; acct = ""; svce = "" }
    END { for (s in names) print s ":" names[s] }' | sort
}
keychain_value() { local hex; hex=$(security find-generic-password -s "$prefix:$store" -a "$name" -w ${in_keychain[@]+"${in_keychain[@]}"} 2>/dev/null) || return 1; printf '%s' "$hex" | xxd -r -p; }
keychain_remove() { security delete-generic-password -s "$prefix:$store" -a "$name" ${in_keychain[@]+"${in_keychain[@]}"} >/dev/null 2>&1; return 0; }

case $cmd in
  set) check_store; check_name; "${backend}_set" ;;
  names) [[ -z $store ]] || check_store; "${backend}_names" ;;
  value) check_store; check_name; "${backend}_value" ;;
  remove) check_store; check_name; "${backend}_remove" ;;
  protected) check_store; protected "$store" ;;
  migrate)
    [[ $backend == keychain ]] || { echo "nothing to migrate: values are kept in files here" >&2; exit 2; }
    shopt -s nullglob
    for f in "$dir"/*.env; do
      store=$(basename "$f" .env); check_store; moved=0
      for name in $(sed -nE 's/^export ([A-Za-z_][A-Za-z0-9_]*)=.*/\1/p' "$f"); do
        files_value | keychain_set
        security find-generic-password -s "$prefix:$store" -a "$name" ${in_keychain[@]+"${in_keychain[@]}"} >/dev/null 2>&1 || { echo "$store: $name could not be moved; its file is kept" >&2; moved=-1; break; }
        moved=$((moved + 1))
      done
      (( moved >= 0 )) && { rm -f "$f"; echo "$store: moved $moved to the Keychain"; }
    done ;;
  *) echo "usage: secret-store set|names|value|remove|migrate|protected ..." >&2; exit 2 ;;
esac
