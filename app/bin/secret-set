#!/usr/bin/env bash
# Stores one secret for an app without echoing it. Run in your own terminal, not through an agent.
# Usage: secret-set <app> <ENV_NAME>            (hidden prompt)
#        <fetch command> | secret-set <app> <ENV_NAME> --stdin   (never shown on screen)
# For an environment other than the stack's first, name the store <app>@<env>, e.g. orders-api@prod.
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)
app=${1:?usage: secret-set <app> <ENV_NAME>}; key=${2:?usage: secret-set <app> <ENV_NAME>}
[[ $app =~ ^[a-z0-9-]+(@[a-z0-9-]+)?$ ]] || { echo "invalid app id: $app" >&2; exit 1; }
[[ $key =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo "invalid env name: $key" >&2; exit 1; }
from_stdin=false; [[ ${3:-} == --stdin ]] && from_stdin=true
$from_stdin || [[ -t 0 ]] || { echo "run this in an interactive terminal, or pipe the value in with --stdin" >&2; exit 1; }

if $from_stdin; then value=$(cat); value=${value%$'\n'}; else IFS= read -rsp "Value for $key ($app): " value; echo; fi
[[ -n $value ]] || { echo "empty value, nothing saved" >&2; exit 1; }
printf '%s' "$value" | "$here/secret-store" set "$app" "$key"
echo "Saved $key for $app (${#value} chars)"
