#!/usr/bin/env bash
# Opens psql with a stored database connection string, or adds it to ~/.pgpass so psql and other tools find the password.
# Run in your own terminal, not through an agent. The password is never printed.
# Usage: secret-psql <app or app@env> <ENV_NAME> [psql args...]     open psql
#        secret-psql <app or app@env> <ENV_NAME> --pgpass           add or replace its ~/.pgpass line
set -euo pipefail
app=${1:?usage: secret-psql <app> <ENV_NAME> [--pgpass | psql args...]}; key=${2:?usage: secret-psql <app> <ENV_NAME> [--pgpass | psql args...]}; shift 2
[[ $app =~ ^[a-z0-9-]+(@[a-z0-9-]+)?$ ]] || { echo "invalid app id: $app" >&2; exit 2; }
[[ $key =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo "invalid env name: $key" >&2; exit 2; }
here=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)
value=$("$here/secret-store" value "$app" "$key") || value=
[[ -n $value ]] || { echo "$key is not stored for $app" >&2; exit 2; }

# ponytail: reads Key=Value;... as .NET writes it; a value containing ";" needs a real parser
field() { printf '%s' "$value" | tr ';' '\n' | awk -F= -v k="$1" 'tolower($1) ~ "^ *(" k ") *$" { sub(/^[^=]*=/, ""); print; exit }'; }
host=$(field 'host|server'); port=$(field 'port'); db=$(field 'database|db'); user=$(field 'username|user id|user|uid'); pass=$(field 'password|pwd')
[[ -n $host && -n $user ]] || { echo "$key is not a database connection string Koppler reads" >&2; exit 2; }
port=${port:-5432}; db=${db:-postgres}

if [[ ${1:-} == --pgpass ]]; then
  pgpass=${PGPASSFILE:-$HOME/.pgpass}
  umask 077; touch "$pgpass"; chmod 600 "$pgpass"
  esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/:/\\:/g'; }
  tmp=$(mktemp "$pgpass.XXXXXX")
  # One line per host name people type for a local tunnel.
  grep -vE "^(localhost|127\.0\.0\.1):$port:$(esc "$db"):$(esc "$user"):" "$pgpass" > "$tmp" || true
  for h in $([[ $host == localhost || $host == 127.0.0.1 ]] && echo "localhost 127.0.0.1" || echo "$host"); do
    printf '%s:%s:%s:%s:%s\n' "$h" "$port" "$(esc "$db")" "$(esc "$user")" "$(esc "$pass")" >> "$tmp"
  done
  mv "$tmp" "$pgpass"
  echo "Added $host:$port, database $db, user $user to $pgpass"
  exit 0
fi

psql=$(command -v psql || ls /opt/homebrew/opt/libpq/bin/psql /usr/local/opt/libpq/bin/psql 2>/dev/null | head -1)
[[ -n $psql ]] || { echo "psql is not installed (brew install libpq)" >&2; exit 2; }
PGPASSWORD=$pass exec "$psql" -h "$host" -p "$port" -U "$user" -d "$db" "$@"
