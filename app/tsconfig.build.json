{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "src/**/*.mts", "src/**/*.mjs"],
  "exclude": ["src/**/*.test.ts", "src/**/testing/**"]
}
